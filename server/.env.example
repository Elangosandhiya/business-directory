# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin for CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection
# Option 1: Full Connection String URI
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/business_directory

# Option 2: Individual Connection Parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=business_directory
PGUSER=postgres
PGPASSWORD=postgres
